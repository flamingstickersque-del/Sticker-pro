# ==============================================================================
# StickerCut PRO - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Cloudinary Artwork CDN & Upload Configuration (Client-Safe / Unsigned Preset)
# ------------------------------------------------------------------------------
# Your Cloudinary account Cloud Name (Dashboard > Cloud Name)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Name of your UNISGNED upload preset (Settings > Upload > Upload Presets)
# Ensure Signing Mode is set to "Unsigned" in the Cloudinary Console.
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# SECURITY WARNING:
# Do NEVER set or bundle CLOUDINARY_API_SECRET in this file or any VITE_* variable.
# The client web application and Tauri desktop application use direct unsigned uploads.
